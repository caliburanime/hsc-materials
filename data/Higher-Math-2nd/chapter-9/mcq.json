    {
      "id": "higher_math_2nd-ch9-mcq-001",
      "text": "ভূমি হতে 150 মিটার উঁচু একটি স্থান হতে একটি ভারী বস্তুকে ছেড়ে দেওয়া হল। ভূমিতে পতনের সময় বেগ কত হবে?",
      "text_en": null,
      "image": null,
      "options": [
        {
          "label": "a",
          "text": "29.4 মি./সে.",
          "image": null
        },
        {
          "label": "b",
          "text": "54.2 মি./সে.",
          "image": null
        },
        {
          "label": "c",
          "text": "5.53 মি./সে.",
          "image": null
        },
        {
          "label": "d",
          "text": "14.2 মি./সে.",
          "image": null
        }
      ],
      "answer": "b",
      "answer_source": "printed",
      "explanation": "\\(v^2=u^2+2gh=0+2\\times9.8\\times150=2940\\)\n\\(v=\\sqrt{2940}\\approx54.2\\) মি./সে.।",
      "source": {
