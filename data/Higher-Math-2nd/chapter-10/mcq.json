    {
      "id": "higher_math_2nd-ch10-mcq-002",
      "text": "2, 3, 4, 7 সংখ্যাগুলোর গড় ব্যবধান কত?",
      "text_en": null,
      "image": null,
      "options": [
        {
          "label": "a",
          "text": "0",
          "image": null
        },
        {
          "label": "b",
          "text": "\\(\\dfrac{2}{3}\\)",
          "image": null
        },
        {
          "label": "c",
          "text": "\\(\\dfrac{3}{2}\\)",
          "image": null
        },
        {
          "label": "d",
          "text": "4",
          "image": null
        }
      ],
      "answer": "c",
      "answer_source": "derived",
      "explanation": "গড় \\(\\bar{x} = \\dfrac{2+3+4+7}{4} = 4\\)\nগড় ব্যবধান \\(= \\dfrac{|2-4|+|3-4|+|4-4|+|7-4|}{4} = \\dfrac{2+1+0+3}{4} = \\dfrac{3}{2}\\)।",
      "source": {
        "board": "ALL",
        "year": "2026",
        "qno": 2,
        "session": null
      },
      "tags": [],
      "difficulty": null,
      "review_note": "The mean is 4, so the mean deviation is (2 + 1 + 0 + 3)/4 = 3/2."
    },
