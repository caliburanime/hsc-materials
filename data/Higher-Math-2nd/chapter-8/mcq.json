    {
      "id": "higher_math_2nd-ch8-mcq-020",
      "text": "লব্ধি বল P বলের উপর লম্ব হলে বলদ্বয়ের অন্তর্গত কোণ কত?",
      "text_en": null,
      "image": null,
      "stem": "\\(P = 5\\sqrt{2}\\) N এবং \\(Q = 10\\) N দুইটি অসমান্তরাল বল।",
