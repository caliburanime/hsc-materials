        },
        {
          "label": "d",
          "text": "\\(\\dfrac{215}{8}\\)",
          "image": null
        }
      ],
      "answer": "b",
      "answer_source": "printed",
      "explanation": "\\(\\alpha+\\beta=\\dfrac52,\\ \\alpha\\beta=\\dfrac32\\)\n\\(\\alpha^3+\\beta^3=(\\alpha+\\beta)^3-3\\alpha\\beta(\\alpha+\\beta)=\\dfrac{125}{8}-3\\cdot\\dfrac32\\cdot\\dfrac52=\\dfrac{125-90}{8}=\\dfrac{35}{8}\\)",
