    {
      "id": "higher_math_2nd-ch3-mcq-012",
      "text": "\\(z = 2 - 2i\\) হলে—",
      "text_en": null,
      "image": null,
      "statements": [
        {
          "label": "i",
          "text": "\\(\\mathrm{Re}(z) + \\mathrm{Im}(z) = 0\\)"
        },
        {
          "label": "ii",
          "text": "\\(z\\bar{z} = 8\\)"
        },
        {
          "label": "iii",
          "text": "z এর পোলার আকার \\(2\\sqrt{2}\\left(\\cos\\dfrac{\\pi}{4} - i\\sin\\dfrac{\\pi}{4}\\right)\\)"
        }
      ],
      "options": [
        {
          "label": "a",
          "text": "i ও ii",
          "image": null
        },
        {
          "label": "b",
          "text": "i ও iii",
          "image": null
        },
        {
          "label": "c",
          "text": "ii ও iii",
          "image": null
        },
        {
          "label": "d",
          "text": "i, ii ও iii",
          "image": null
        }
      ],
      "answer": "d",
      "answer_source": "printed",
      "explanation": "\\(z=2-2i\\)\n(i) সত্য: \\(2+(-2)=0\\)।\n(ii) সত্য: \\(z\\bar z=4+4=8\\)।\n(iii) সত্য: \\(r=2\\sqrt2\\), \\(\\theta=-\\dfrac{\\pi}{4}\\), তাই \\(z=2\\sqrt2\\left(\\cos\\dfrac{\\pi}{4}-i\\sin\\dfrac{\\pi}{4}\\right)\\)।",
      "source": {
        "board": "CUB",
        "year": "2023",
        "qno": 23,
        "session": null
      },
      "tags": [],
      "difficulty": null
    },
    {
      "id": "higher_math_2nd-ch3-mcq-013",
      "text": "\\(z = \\dfrac{2 - 3i}{2 + i}\\) হলে \\(\\mathrm{Re}(z) = ?\\)",
