        {
          "label": "b",
          "text": "\\(-1\\)",
          "image": null
        },
        {
          "label": "c",
          "text": "\\(i\\)",
          "image": null
        },
        {
          "label": "d",
          "text": "\\(-i\\)",
          "image": null
        }
      ],
      "answer": "a",
      "answer_source": "printed",
      "explanation": "\\(i^{4n+4}=(i^4)^{n+1}=1^{n+1}=1\\)",
      "source": {
