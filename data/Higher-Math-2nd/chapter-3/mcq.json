    {
      "id": "higher_math_2nd-ch3-mcq-010",
      "text": "\\(\\dfrac{1}{i}\\) এর বর্গমূল কত?",
      "text_en": null,
      "image": null,
      "options": [
        {
          "label": "a",
          "text": "\\(\\pm\\dfrac{1}{\\sqrt{2}}(1 + i)\\)",
          "image": null
        },
        {
          "label": "b",
          "text": "\\(\\pm\\dfrac{1}{\\sqrt{2}}(1 - i)\\)",
          "image": null
        },
        {
          "label": "c",
          "text": "\\(\\pm(1 + i)\\)",
          "image": null
        },
        {
          "label": "d",
          "text": "\\(\\pm(1 - i)\\)",
          "image": null
        }
      ],
      "answer": "b",
      "answer_source": "printed",
      "explanation": "\\(\\dfrac1i=-i\\)\n\\(\\left(\\dfrac{1-i}{\\sqrt2}\\right)^2=\\dfrac{1-2i-1}{2}=-i\\)\nঅতএব বর্গমূল \\(\\pm\\dfrac{1}{\\sqrt2}(1-i)\\)",
      "source": {
        "board": "CUB",
        "year": "2023",
        "qno": 15,
        "session": null
      },
      "tags": [],
      "difficulty": null
    },
    {
      "id": "higher_math_2nd-ch3-mcq-011",
      "text": "\\(i^5 + i^6 + i^7 + i^8 + i^9\\) এর মান কত?",
