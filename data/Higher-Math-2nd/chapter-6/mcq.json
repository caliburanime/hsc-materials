      "tags": [],
      "difficulty": null
    },
    {
      "id": "higher_math_2nd-ch6-mcq-012",
      "text": "অধিবৃত্তটির নিয়ামক রেখাদ্বয়ের মধ্যবর্তী দূরত্ব কত একক?",
      "text_en": null,
      "image": null,
      "stem": "\\(4y^2 - 5x^2 = 20\\) একটি অধিবৃত্তের সমীকরণ।",
      "stem_image": null,
