      "tags": [],
      "difficulty": null
    },
    {
      "id": "higher_math_2nd-ch6-mcq-005",
      "text": "\\(\\dfrac{x^2}{a^2} + \\dfrac{y^2}{b^2} = 1\\) উপবৃত্তের উপকেন্দ্রের স্থানাংক কত? \\((a > b)\\)",
      "text_en": null,
      "image": null,
      "options": [
        {
          "label": "a",
          "text": "\\(\\left(\\pm\\sqrt{a^2 + b^2}, 0\\right)\\)",
          "image": null
        },
        {
          "label": "b",
          "text": "\\(\\left(\\pm\\sqrt{a^2 - b^2}, 0\\right)\\)",
          "image": null
        },
        {
          "label": "c",
          "text": "\\((\\pm a/e, 0)\\)",
          "image": null
        },
        {
          "label": "d",
          "text": "\\((0, \\pm ae)\\)",
          "image": null
        }
      ],
      "answer": "b",
      "answer_source": "printed",
      "explanation": "\\(a>b\\) হলে \\(b^2=a^2(1-e^2)\\), অতএব \\(ae=\\sqrt{a^2-b^2}\\)\nউপকেন্দ্র \\(\\left(\\pm\\sqrt{a^2-b^2},\\,0\\right)\\)",
      "source": {
        "board": "BB",
        "year": "2023",
        "qno": 11,
        "session": null
      },
      "tags": [],
      "difficulty": null
    },
    {
      "id": "higher_math_2nd-ch6-mcq-006",
      "text": "\\(3x^2 - 4y^2 = 12\\) অধিবৃত্তের \\((4, 3)\\) বিন্দুতে স্পর্শকের ঢালের মান—",
      "text_en": null,
      "image": null,
      "options": [
        {
          "label": "a",
          "text": "\\(-1\\)",
