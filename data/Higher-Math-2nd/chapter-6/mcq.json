        {
          "label": "b",
          "text": "\\(\\dfrac{3}{4}\\)",
          "image": null
        },
        {
          "label": "c",
          "text": "\\(1\\)",
          "image": null
        },
        {
          "label": "d",
          "text": "\\(\\dfrac{4}{3}\\)",
          "image": null
        }
      ],
      "answer": "c",
      "answer_source": "printed",
      "explanation": "\\(6x-8y\\dfrac{dy}{dx}=0\\Rightarrow\\dfrac{dy}{dx}=\\dfrac{3x}{4y}\\)\n\\((4,3)\\) বিন্দুতে ঢাল \\(=\\dfrac{12}{12}=1\\)",
      "source": {
        "board": "CB",
        "year": "2023",
