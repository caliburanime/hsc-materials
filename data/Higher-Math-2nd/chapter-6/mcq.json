      ],
      "options": [
        {
          "label": "a",
          "text": "i ও ii",
          "image": null
        },
        {
          "label": "b",
          "text": "i ও iii",
          "image": null
        },
        {
          "label": "c",
          "text": "ii ও iii",
          "image": null
        },
        {
          "label": "d",
          "text": "i, ii ও iii",
          "image": null
        }
      ],
      "answer": "c",
      "answer_source": "printed",
      "explanation": "\\((x-2)^2=-12y+36=-12(y-3)\\)\nশীর্ষ \\((2,3)\\), \\(4a=12\\Rightarrow a=3\\), নিচের দিকে খোলা।\n(i) মিথ্যা: উপকেন্দ্র \\((2,0)\\)।\n(ii) সত্য: নিয়ামক \\(y=3+3=6\\)।\n(iii) সত্য: শীর্ষ \\((2,3)\\)।",
      "source": {
        "board": "BB",
        "year": "2023",
        "qno": 6,
        "session": null
