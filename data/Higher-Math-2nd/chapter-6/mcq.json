          "image": null
        }
      ],
      "answer": "b",
      "answer_source": "printed",
      "explanation": "\\(\\cos\\theta=\\dfrac x2,\\ \\sin\\theta=\\dfrac y{\\sqrt3}\\)\n\\(\\dfrac{x^2}{4}+\\dfrac{y^2}{3}=1\\), যা উপবৃত্ত।",
