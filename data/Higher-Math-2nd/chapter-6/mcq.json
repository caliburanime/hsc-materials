    {
      "id": "higher_math_2nd-ch6-mcq-011",
      "text": "অধিবৃত্তটির অসীমতট রেখার সমীকরণ কোনটি?",
      "text_en": null,
      "image": null,
      "stem": "\\(4y^2 - 5x^2 = 20\\) একটি অধিবৃত্তের সমীকরণ।",
      "stem_image": null,
      "group": "higher_math_2nd-2023-CUB-6-7",
