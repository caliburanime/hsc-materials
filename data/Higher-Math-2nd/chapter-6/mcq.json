        {
          "label": "b",
          "text": "\\(y = \\pm\\dfrac{2}{\\sqrt{5}}x\\)",
          "image": null
        },
        {
          "label": "c",
          "text": "\\(x = \\pm\\dfrac{\\sqrt{5}}{2}y\\)",
          "image": null
        },
        {
          "label": "d",
          "text": "\\(x = \\pm\\dfrac{2}{\\sqrt{5}}y\\)",
          "image": null
        }
      ],
      "answer": "a",
      "answer_source": "printed",
      "explanation": "\\(\\dfrac{y^2}{5}-\\dfrac{x^2}{4}=1\\), এখানে \\(a^2=5,\\ b^2=4\\)\nঅসীমতট: \\(y=\\pm\\dfrac abx=\\pm\\dfrac{\\sqrt5}{2}x\\)",
