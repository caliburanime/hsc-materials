    {
      "id": "higher_math_2nd-ch6-mcq-004",
      "text": "\\(x^2 - 4x + 12y - 32 = 0\\) পরাবৃত্তের—",
      "text_en": null,
      "image": null,
      "statements": [
        {
          "label": "i",
          "text": "উপকেন্দ্র \\((2, -6)\\)"
        },
        {
          "label": "ii",
          "text": "নিয়ামকের সমীকরণ \\(y = 6\\)"
        },
        {
          "label": "iii",
          "text": "শীর্ষ বিন্দু \\((2, 3)\\)"
