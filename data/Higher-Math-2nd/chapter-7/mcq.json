    {
      "id": "higher_math_2nd-ch7-mcq-014",
      "text": "\\(\\dfrac{1}{2}\\sin^{-1}\\dfrac{4}{5} = ?\\)",
      "text_en": null,
      "image": null,
      "options": [
        {
          "label": "a",
          "text": "\\(\\tan^{-1}\\left(\\dfrac{1}{2}\\right)\\)",
          "image": null
        },
        {
          "label": "b",
          "text": "\\(\\tan^{-1}(2)\\)",
          "image": null
        },
        {
          "label": "c",
          "text": "\\(\\cos^{-1}\\left(\\dfrac{3}{4}\\right)\\)",
          "image": null
        },
        {
          "label": "d",
          "text": "\\(\\sin^{-1}\\left(\\dfrac{2}{5}\\right)\\)",
          "image": null
        }
      ],
      "answer": "a",
      "answer_source": "printed",
      "explanation": "\\(\\sin^{-1}\\dfrac45=\\varphi\\) ধরলে \\(\\sin\\varphi=\\dfrac45,\\ \\cos\\varphi=\\dfrac35\\)।\n\\(\\tan\\dfrac\\varphi2=\\dfrac{\\sin\\varphi}{1+\\cos\\varphi}=\\dfrac{4/5}{8/5}=\\dfrac12\\)।\nঅতএব \\(\\dfrac12\\sin^{-1}\\dfrac45=\\tan^{-1}\\dfrac12\\)।",
      "source": {
        "board": "DB",
        "year": "2023",
        "qno": 6,
        "session": null
      },
      "tags": [],
      "difficulty": null
    },
    {
