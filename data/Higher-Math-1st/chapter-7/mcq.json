          "label": "a",
          "text": "\\(-\\dfrac{11}{24}\\)",
          "image": null
        },
        {
          "label": "b",
          "text": "\\(\\dfrac{11}{24}\\)",
          "image": null
        },
        {
          "label": "c",
          "text": "\\(\\dfrac{29}{36}\\)",
          "image": null
        },
        {
          "label": "d",
          "text": "\\(\\dfrac{43}{48}\\)",
          "image": null
        }
      ],
      "answer": "c",
      "answer_source": "printed",
      "explanation": "\\(a=6,\\ b=4,\\ c=3\\)।\n\\(\\cos B=\\dfrac{a^2+c^2-b^2}{2ac}=\\dfrac{36+9-16}{36}=\\dfrac{29}{36}\\)",
      "source": {
