          "image": null
        },
        {
          "label": "d",
          "text": "\\(\\tan A\\tan B = 1\\)",
          "image": null
        }
      ],
      "answer": "d",
      "answer_source": "printed",
      "explanation": "\\(B=\\dfrac{\\pi}{2}-A\\Rightarrow\\tan B=\\cot A\\)\n\\(\\therefore\\tan A\\tan B=1\\)",
