        "session": null
      },
      "tags": [],
      "difficulty": null
    },
    {
      "id": "higher_math_1st-ch7-mcq-005",
      "text": "\\(A + B = \\dfrac{\\pi}{2}\\) হলে নিম্নের কোনটি সঠিক?",
