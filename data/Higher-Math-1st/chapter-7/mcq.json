          "image": null
        }
      ],
      "answer": "a",
      "answer_source": "printed",
      "explanation": "\\(\\cos C=\\dfrac{a^2+b^2-c^2}{2ab}=\\dfrac{2ab}{2ab}=1\\)\n\\(\\therefore C=0^\\circ\\)",
