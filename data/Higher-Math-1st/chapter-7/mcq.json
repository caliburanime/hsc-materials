      "tags": [],
      "difficulty": null
    },
    {
      "id": "higher_math_1st-ch7-mcq-012",
      "text": "\\(\\tan\\dfrac{\\theta}{2} = \\dfrac{3}{4}\\) হলে \\(\\cos\\theta\\) এর মান কত?",
