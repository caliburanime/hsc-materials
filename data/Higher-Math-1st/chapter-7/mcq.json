      "image": null,
      "stem": "",
      "stem_image": "assets/higher_math_1st-ch7-mcq-003-stem.svg",
      "group": "higher_math_1st-2023-BB-17-18",
      "options": [
        {
          "label": "a",
          "text": "\\(\\sin A = 2\\sin C\\)",
          "image": null
        },
        {
          "label": "b",
          "text": "\\(2\\sin A = \\sin C\\)",
          "image": null
        },
        {
          "label": "c",
          "text": "\\(3\\sin A = 2\\sin C\\)",
          "image": null
        },
        {
          "label": "d",
          "text": "\\(2\\sin A = 3\\sin C\\)",
          "image": null
        }
      ],
      "answer": "a",
      "answer_source": "printed",
      "explanation": "\\(BC=a=6,\\ AB=c=3\\)। সাইন সূত্রে \\(\\dfrac{\\sin A}{a}=\\dfrac{\\sin C}{c}\\)\n\\(\\dfrac{\\sin A}{6}=\\dfrac{\\sin C}{3}\\Rightarrow\\sin A=2\\sin C\\)",
      "source": {
        "board": "BB",
        "year": "2023",
        "qno": 17,
        "session": null
      },
      "tags": [],
      "difficulty": null
