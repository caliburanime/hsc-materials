      ],
      "answer": "d",
      "answer_source": "printed",
      "explanation": "\\(t=2x\\) ধরলে \\(y=\\tan^{-1}\\dfrac{2t}{1-t^2}=2\\tan^{-1}t=2\\tan^{-1}2x\\)\n\\(\\dfrac{dy}{dx}=2\\cdot\\dfrac{2}{1+4x^2}=\\dfrac{4}{1+4x^2}\\)",
      "source": {
