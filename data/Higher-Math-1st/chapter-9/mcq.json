      ],
      "answer": "c",
      "answer_source": "printed",
      "explanation": "\\(y^2=x+y\\) (কারণ \\(y=\\sqrt{x+y}\\))\n\\(2y\\dfrac{dy}{dx}=1+\\dfrac{dy}{dx}\\Rightarrow\\dfrac{dy}{dx}=\\dfrac{1}{2y-1}\\)",
      "source": {
