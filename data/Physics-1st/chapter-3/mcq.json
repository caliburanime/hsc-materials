    {
      "id": "physics_1st-ch3-mcq-006",
      "text": "100 kg ভরের একটি পাথরকে 200 m উঁচু থেকে ফেলে দেয়া হলো। বাতাসের বাধা অগ্রাহ্য করা হলে এবং \\(g = 9.8\\,\\mathrm{ms^{-2}}\\) হলে 3s পর পাথরটি মাটি থেকে কত উঁচুতে থাকবে?",
      "text_en": null,
      "image": null,
      "options": [
        {
          "label": "a",
          "text": "14.7 m",
          "image": null
        },
        {
          "label": "b",
          "text": "44.1 m",
          "image": null
        },
        {
          "label": "c",
          "text": "155.9 m",
          "image": null
        },
        {
          "label": "d",
          "text": "185.3 m",
          "image": null
        }
      ],
      "answer": "c",
      "answer_source": "printed",
      "explanation": "3 s এ পতন \\( s = \\frac{1}{2}gt^2 = \\frac{1}{2}\\times9.8\\times3^2 = 44.1\\,\\mathrm{m} \\)\nমাটি থেকে উচ্চতা \\( = 200 - 44.1 = 155.9\\,\\mathrm{m} \\)",
      "source": {
        "board": "JB",
        "year": "2023",
        "qno": 24,
        "session": null
      },
      "tags": [],
      "difficulty": null
    },
